{
  "format": "locationstudio-environment-grammars",
  "version": 1,
  "schema": {
    "document": {
      "id": "letters, digits, _ or -",
      "name": "display name",
      "description": "text",
      "include": "grammar id or list: their params and rules are inherited, this document's override them",
      "start": "rule to run first",
      "size": "[x, y, z] m of the start scope (centred on the origin, floor at z = 0)",
      "params": "{name: default value}; override per generation",
      "rules": "{Name: [operations] | {params, if, do: [operations]} | {params, variants: [{weight, if, do}]}}",
      "populate": "[{kind asset|procedural|decal|light|effect|marker, tags, traits, pattern random|grid|line|center, count | per_surface | density | spacing, footprint, height, elevation, offset, yaw, if, ...kind fields}]: placements on the semantic surfaces of what the generation built (see SEMANTIC-SURFACES.md)"
    },
    "scope": "Every rule runs in an oriented box: x along it, y across it, z up, origin at its min corner. sx, sy, sz are its size.",
    "values": "In numeric fields (sizes, at, every, step, count, width, yaw, ...) a string is an expression. Elsewhere (room specs, generator params, materials, config) a string is literal unless it starts with = (expression) or is $name (a variable, any type). Names may contain {expression}.",
    "expressions": "numbers, 'strings', variables ($ optional), + - * / % ^, < <= > >= == !=, and or not (&& || !), c ? a : b, min max floor ceil round abs sqrt sin cos clamp if rand randint opposite, has(list, value) count(list) pick(list, index from 0)",
    "variables": "grammar params, set variables, rule params, sx sy sz, i n (index/count from split, repeat and walls), side (walls), t (wall thickness after room), room_type (after a typed room), depth, pi",
    "room_types": "A room with type (clinic, office, storage, security, maintenance, corridor, server_room, ... see ROOM-TYPES.md) takes that type's spec defaults and surface traits, its params override grammar defaults for the rest of the rule, and once all doors are known its interior rules furnish the room (furniture in front of doors is left out) and its populate entries place items on the room's surfaces. furnish: false keeps the defaults but skips the interior and placements. Interior rules come from the grammar or the room_interiors grammar.",
    "structural": {
      "split": "{axis x|y|z, parts: [{size: expression | '~weight', symbol | do, params}]}: absolute parts first, the rest shared by weight",
      "repeat": "{axis, every (about N m, fitted) | step (exactly N m, centred or from offset) | count, size?, offset?, margin?, symbol | do, params}",
      "place": "{at [x,y,z] (min corner) | center [x,y,z], size?, yaw?, symbol | do, params}",
      "walls": "{sides [north, south, east, west] (default all), depth, inset, symbol | do, params}: strips along the inside of each side, x along the wall, y inward",
      "call": "'Rule' or {symbol, params}: run a rule in this scope (a bare string operation is a call)",
      "choose": "[{weight, if, symbol | do, params}]: one, seeded",
      "chance": "{p, symbol | do, params, else}",
      "set": "{name: expression}: variables for the rest of the rule and its children"
    },
    "terminals": {
      "room": "parametric room spec (type, furnish, wall_thickness, floor, ceiling, trim, materials, lighting, collision, collision_rules, surfaces {floor, walls, exterior, ceiling, traits}, doors, windows, name, height); the scope is its outer footprint; later operations run in its interior",
      "door": "{wall auto|north|south|east|west, width, height, frame, frame_width, shift, connect (default true), asset_id | asset_query, asset_yaw, name}: an opening in the enclosing room's wall nearest the scope centre; connect cuts the room behind it too",
      "window": "{wall, width, height, sill, frame, frame_width, glass, mullions_x, mullions_y, shift, connect}",
      "geometry": "{generator, params, material, collision (default true), collision_rules, layer (default decoration), at (default bottom centre), yaw, pitch, roll, stream_range, surface, surfaces, name}; surface tags the visible top faces (a tag or {tag, traits, retag}); compound parts may carry their own surface",
      "asset": "{asset_id | asset_query, at, yaw, spawn, name}: a Project Asset",
      "light": "{intensity, radius, color | config, preset_id, at (default top centre - 0.15 m), name}",
      "volume": "{shape, purpose, size (default the scope), at, name}: centred on the scope",
      "marker": "{type, category, at, yaw, name}: a location"
    },
    "common_op_keys": "if (condition), name, comment",
    "limits": "32 levels, 5000 rule calls, 1900 items, 200 rooms"
  },
  "grammars": {
    "common": {
      "name": "Common building rules",
      "description": "Reusable rules the other grammars include: corridor, doors, windows, ceiling lights, cable trays, pipes, ducts and furniture blocks. Override CorridorExtras to add to every corridor.",
      "params": {
        "wall": 0.15, "wall_material": "", "floor_material": "", "ceiling_material": "", "trim_material": "",
        "lights": true, "light_every": 4, "light_intensity": 60, "light_radius": 7,
        "door_every": 6, "door_sides": ["north", "south"], "door_width": 1.0, "door_height": 2.1,
        "window_width": 1.6, "window_height": 1.2, "window_sill": 1.0,
        "tray": true, "tray_width": 0.3, "tray_height": 0.08, "tray_drop": 0.35, "pipe_radius": 0.06,
        "room_traits": [], "desk_surface": "desk", "counter_surface": "counter", "workbench_surface": "workbench"
      },
      "rules": {
        "Corridor": [
          {"room": {"type": "corridor", "furnish": false, "surfaces": {"traits": "$room_traits"}, "name": "Corridor", "wall_thickness": "$wall", "ceiling": {"type": "flat"},
                    "materials": {"walls": "$wall_material", "floor": "$floor_material", "ceiling": "$ceiling_material", "trim": "$trim_material"}}},
          {"if": "door_every > 0", "walls": {"sides": "$door_sides", "depth": 0.4,
             "do": [{"repeat": {"axis": "x", "every": "door_every", "symbol": "Door"}}]}},
          {"repeat": {"axis": "x", "every": "light_every", "symbol": "CeilingLight"}},
          {"if": "tray", "walls": {"sides": ["north"], "depth": 0.5, "symbol": "CableTray"}},
          "CorridorExtras"
        ],
        "CorridorExtras": [],
        "Door": [{"door": {"width": "door_width", "height": "door_height"}}],
        "Window": [{"if": "sx >= 1", "window": {"width": "min(sx - 0.6, window_width)", "height": "window_height", "sill": "window_sill"}}],
        "CeilingLight": [
          {"if": "lights", "light": {"intensity": "$light_intensity", "radius": "$light_radius"}},
          {"geometry": {"generator": "box", "name": "Light panel", "params": {"size": [0.6, 0.6, 0.04]}, "at": ["sx/2", "sy/2", "sz - 0.04"], "collision": false}}
        ],
        "CableTray": [
          {"geometry": {"generator": "compound", "name": "Cable tray", "at": ["sx/2", "sy/2", "sz - tray_drop"], "collision": false,
            "params": {"parts": [
              {"shape": "box", "center": [0, 0, 0.005], "size": ["=sx", "=tray_width", 0.01]},
              {"shape": "box", "center": [0, "=tray_width/2", "=tray_height/2"], "size": ["=sx", 0.01, "=tray_height"]},
              {"shape": "box", "center": [0, "=-tray_width/2", "=tray_height/2"], "size": ["=sx", 0.01, "=tray_height"]}
            ]}}}
        ],
        "PipeRun": [
          {"geometry": {"generator": "pipe", "name": "Pipe", "at": ["sx/2", "sy/2", "sz - 0.5"], "collision": false,
            "params": {"points": [["=-sx/2", 0, 0], ["=sx/2", 0, 0]], "radius": "$pipe_radius", "sides": 12}}}
        ],
        "Duct": [
          {"geometry": {"generator": "duct", "name": "Duct", "at": ["sx/2", "sy/2", "sz - 0.3"], "collision": false,
            "params": {"points": [["=-sx/2", 0, 0], ["=sx/2", 0, 0]], "width": 0.5, "height": 0.3}}}
        ],
        "Shelf": [
          {"geometry": {"generator": "compound", "name": "Shelf",
            "params": {"parts": [
              {"shape": "box", "center": ["=-(sx-0.1)/2 + 0.02", 0, 0.9], "size": [0.04, 0.45, 1.8]},
              {"shape": "box", "center": ["=(sx-0.1)/2 - 0.02", 0, 0.9], "size": [0.04, 0.45, 1.8]},
              {"shape": "box", "center": [0, 0, 0.1], "size": ["=sx-0.1", 0.45, 0.03], "surface": "shelf"},
              {"shape": "box", "center": [0, 0, 0.6], "size": ["=sx-0.1", 0.45, 0.03], "surface": "shelf"},
              {"shape": "box", "center": [0, 0, 1.1], "size": ["=sx-0.1", 0.45, 0.03], "surface": "shelf"},
              {"shape": "box", "center": [0, 0, 1.6], "size": ["=sx-0.1", 0.45, 0.03], "surface": "shelf"}
            ]}}}
        ],
        "ShelfRow": [{"repeat": {"axis": "x", "every": 2, "margin": 0.3, "symbol": "Shelf"}}],
        "Workbench": [
          {"geometry": {"generator": "compound", "name": "Workbench",
            "params": {"parts": [
              {"shape": "box", "center": [0, 0, 0.875], "size": ["=sx", "=sy", 0.05], "surface": "$workbench_surface"},
              {"shape": "box", "center": ["=sx/2-0.05", "=sy/2-0.05", 0.425], "size": [0.06, 0.06, 0.85]},
              {"shape": "box", "center": ["=-sx/2+0.05", "=sy/2-0.05", 0.425], "size": [0.06, 0.06, 0.85]},
              {"shape": "box", "center": ["=sx/2-0.05", "=-sy/2+0.05", 0.425], "size": [0.06, 0.06, 0.85]},
              {"shape": "box", "center": ["=-sx/2+0.05", "=-sy/2+0.05", 0.425], "size": [0.06, 0.06, 0.85]}
            ]}}}
        ],
        "Counter": [{"geometry": {"generator": "box", "name": "Counter", "surface": "$counter_surface", "params": {"size": ["=sx", "=sy", 0.9]}}}],
        "Cabinet": [{"geometry": {"generator": "box", "name": "Cabinet", "surface": "cabinet", "params": {"size": ["=sx", "=sy", 1.9]}}}],
        "Desk": [
          {"geometry": {"generator": "compound", "name": "Desk",
            "params": {"parts": [
              {"shape": "box", "center": [0, 0, 0.74], "size": ["=sx", "=sy", 0.04], "surface": "$desk_surface"},
              {"shape": "box", "center": ["=-sx/2+0.02", 0, 0.36], "size": [0.04, "=sy", 0.72]},
              {"shape": "box", "center": ["=sx/2-0.02", 0, 0.36], "size": [0.04, "=sy", 0.72]}
            ]}}}
        ],
        "Bed": [
          {"geometry": {"generator": "compound", "name": "Bed",
            "params": {"parts": [
              {"shape": "box", "center": [0, 0, 0.175], "size": ["=sx", "=sy", 0.35]},
              {"shape": "box", "center": [0, 0, 0.425], "size": ["=sx-0.05", "=sy-0.05", 0.15], "surface": "bed"},
              {"shape": "box", "center": ["=-sx/2+0.025", 0, 0.45], "size": [0.05, "=sy", 0.9]}
            ]}}}
        ],
        "Bunk": [
          {"geometry": {"generator": "compound", "name": "Bunk",
            "params": {"parts": [
              {"shape": "box", "center": [0, 0, 0.35], "size": ["=sx", "=sy", 0.12], "surface": "bed"},
              {"shape": "box", "center": [0, 0, 1.35], "size": ["=sx", "=sy", 0.12], "surface": "bed"},
              {"shape": "box", "center": ["=-sx/2+0.03", "=-sy/2+0.03", 0.9], "size": [0.06, 0.06, 1.8]},
              {"shape": "box", "center": ["=sx/2-0.03", "=-sy/2+0.03", 0.9], "size": [0.06, 0.06, 1.8]},
              {"shape": "box", "center": ["=-sx/2+0.03", "=sy/2-0.03", 0.9], "size": [0.06, 0.06, 1.8]},
              {"shape": "box", "center": ["=sx/2-0.03", "=sy/2-0.03", 0.9], "size": [0.06, 0.06, 1.8]}
            ]}}}
        ],
        "Crate": [{"geometry": {"generator": "box", "name": "Crate", "yaw": "rand(-20, 20)", "surface": "crate",
                   "params": {"size": ["=rand(0.6, 1.2)", "=rand(0.6, 1.0)", "=rand(0.5, 1.0)"]}}}]
      }
    },
    "room_interiors": {
      "name": "Room type interiors",
      "description": "Interior rules of the built-in room types (ROOM-TYPES.md). Every grammar can use them; a grammar that defines a rule of the same name (Desk, Shelf, OfficeInterior...) overrides it. They run in a typed room's interior once its doors are known and see room_type, room_width, room_length, room_height, doors_on, windows_on, wall_sides, free_sides, wall_side, free_side, entry_side, back_side and long_axis.",
      "include": "common",
      "params": {"desk_spacing": 2.4, "crates": true, "rack_aisle": 1.2},
      "rules": {
        "CorridorInterior": [
          {"if": "tray && long_axis == 'x'", "call": "CableTray"},
          {"if": "tray && long_axis == 'y'", "place": {"center": ["sx/2", "sy/2", "sz/2"], "size": ["sy", "sx", "sz"], "yaw": 90, "symbol": "CableTray"}}
        ],
        "OfficeInterior": [
          {"if": "room_width >= 3 && room_length >= 3", "place": {"at": [1, 1, 0], "size": ["sx - 2", "sy - 2", "sz"], "do": [
            {"repeat": {"axis": "y", "every": "desk_spacing", "do": [
              {"repeat": {"axis": "x", "every": 1.8, "do": [
                {"place": {"at": ["sx/2 - 0.7", "sy/2 - 0.35", 0], "size": [1.4, 0.7, 1], "symbol": "Desk"}}]}}]}}]}},
          {"if": "free_side != '' && room_width >= 3 && room_length >= 3", "walls": {"sides": ["$free_side"], "depth": 0.5, "do": [
            {"repeat": {"axis": "x", "step": 0.9, "size": 0.8, "count": "min(3, floor((sx - 2.2) / 0.9))", "symbol": "Cabinet"}}]}}
        ],
        "ReceptionInterior": [
          {"if": "back_side != '' && room_width >= 3 && room_length >= 3", "walls": {"sides": ["$back_side"], "depth": 1.6, "do": [
            {"place": {"at": ["sx/2 - min(1.5, sx/2 - 1)", 0.9, 0], "size": ["min(3, sx - 2)", 0.6, 1], "symbol": "Counter"}}]}}
        ],
        "ClinicInterior": [
          {"if": "wall_side != ''", "walls": {"sides": ["$wall_side"], "depth": 1.0, "do": [
            {"if": "sx >= 2.2", "place": {"at": ["sx/2 - 1", 0.05, 0], "size": [2.0, 0.9, 1], "symbol": "Bed"}}]}},
          {"if": "count(wall_sides) > 1 && min(room_width, room_length) >= 3.4", "walls": {"sides": ["=pick(wall_sides, 1)"], "depth": 0.7, "do": [
            {"place": {"at": ["sx/2 - min(1, sx/2 - 1.1)", 0.05, 0], "size": ["min(2, sx - 2.2)", 0.6, 1], "symbol": "Counter"}}]}}
        ],
        "StorageInterior": [
          {"walls": {"sides": "$free_sides", "depth": 0.5, "do": [
            {"if": "sx >= 2.2", "place": {"at": [0.6, 0, 0], "size": ["sx - 1.2", 0.5, "sz"], "symbol": "ShelfRow"}}]}},
          {"if": "crates && room_width >= 3.5 && room_length >= 3.5", "place": {"at": [1.4, 1.4, 0], "size": ["sx - 2.8", "sy - 2.8", "sz"], "do": [
            {"repeat": {"axis": "x", "every": 1.8, "do": [{"chance": {"p": 0.6, "symbol": "Crate"}}]}}]}}
        ],
        "SecurityInterior": [
          {"if": "back_side != '' && room_width >= 2.5 && room_length >= 2.5", "walls": {"sides": ["$back_side"], "depth": 0.9, "do": [
            {"place": {"at": ["sx/2 - min(1, sx/2 - 0.6)", 0.1, 0], "size": ["min(2, sx - 1.2)", 0.7, 1], "symbol": "Desk"}}]}},
          {"if": "count(free_sides) > 1 && min(room_width, room_length) >= 3", "walls": {"sides": ["=pick(free_sides, 1)"], "depth": 0.5, "do": [
            {"repeat": {"axis": "x", "step": 0.7, "size": 0.6, "count": "min(4, floor((sx - 2) / 0.7))", "symbol": "Cabinet"}}]}},
          {"volume": {"name": "Security zone", "purpose": "trigger"}}
        ],
        "ArmoryInterior": [
          {"walls": {"sides": "$free_sides", "depth": 0.5, "do": [
            {"repeat": {"axis": "x", "step": 0.7, "size": 0.6, "margin": 0.6, "symbol": "Cabinet"}}]}}
        ],
        "MaintenanceInterior": [
          {"if": "wall_side != ''", "walls": {"sides": ["$wall_side"], "depth": 0.8, "do": [
            {"if": "sx >= 2", "place": {"at": ["sx/2 - min(1.25, sx/2 - 0.6)", 0.05, 0], "size": ["min(2.5, sx - 1.2)", 0.7, 1], "symbol": "Workbench"}}]}},
          {"if": "count(free_sides) > 1 && min(room_width, room_length) >= 3", "walls": {"sides": ["=pick(free_sides, 1)"], "depth": 0.6, "do": [
            {"place": {"at": ["sx/2 - 0.4", 0.05, 0], "size": [0.8, 0.5, 1], "symbol": "Cabinet"}}]}},
          {"walls": {"sides": ["=long_axis == 'x' ? 'north' : 'east'"], "depth": 0.3, "symbol": "PipeRun"}}
        ],
        "WorkshopInterior": [
          {"walls": {"sides": "$wall_sides", "depth": 0.8, "do": [
            {"if": "sx >= 4", "repeat": {"axis": "x", "every": 2.6, "margin": 0.9, "do": [
              {"place": {"at": ["sx/2 - 1.1", 0.05, 0], "size": [2.2, 0.7, 1], "symbol": "Workbench"}}]}}]}},
          {"if": "min(room_width, room_length) >= 4.5", "place": {"at": [1.8, 1.8, 0], "size": ["sx - 3.6", "sy - 3.6", "sz"], "do": [
            {"repeat": {"axis": "x", "every": 2, "do": [{"chance": {"p": 0.5, "symbol": "Crate"}}]}}]}}
        ],
        "ServerInterior": [
          {"if": "long_axis == 'x'", "call": "RackRows"},
          {"if": "long_axis == 'y'", "place": {"center": ["sx/2", "sy/2", "sz/2"], "size": ["sy", "sx", "sz"], "yaw": 90, "symbol": "RackRows"}},
          {"if": "tray", "walls": {"sides": ["=long_axis == 'x' ? 'north' : 'east'"], "depth": 0.5, "symbol": "CableTray"}}
        ],
        "RackRows": [
          {"if": "sx >= 3 && sy >= 3", "place": {"at": [1.1, 1.1, 0], "size": ["sx - 2.2", "sy - 2.2", "sz"], "do": [
            {"repeat": {"axis": "y", "every": "0.6 + rack_aisle", "do": [
              {"place": {"at": [0, "sy/2 - 0.3", 0], "size": ["sx", 0.6, "sz"], "do": [
                {"geometry": {"generator": "box", "name": "Rack row", "surface": "machine", "params": {"size": ["=sx", 0.6, "=min(2.1, sz - 0.3)"]}}}]}}]}}]}}
        ],
        "LabInterior": [
          {"walls": {"sides": "$wall_sides", "depth": 0.75, "do": [
            {"if": "sx >= 3.8", "repeat": {"axis": "x", "every": 2.5, "margin": 0.9, "do": [
              {"place": {"at": ["sx/2 - 1", 0, 0], "size": [2.0, 0.75, 1], "symbol": "Workbench"}}]}}]}}
        ],
        "BedroomInterior": [
          {"if": "wall_side != ''", "walls": {"sides": ["$wall_side"], "depth": 1.5, "do": [
            {"if": "sx >= 2.2", "place": {"at": ["sx/2 - 1", 0.05, 0], "size": [2.0, 1.4, 1], "symbol": "Bed"}}]}},
          {"if": "count(free_sides) > 1 && min(room_width, room_length) >= 4.2", "walls": {"sides": ["=pick(free_sides, 1)"], "depth": 0.6, "do": [
            {"place": {"at": ["sx/2 - 0.6", 0.02, 0], "size": [1.2, 0.55, 1], "symbol": "Cabinet"}}]}}
        ],
        "BunkInterior": [
          {"walls": {"sides": "$free_sides", "depth": 0.95, "do": [
            {"repeat": {"axis": "x", "step": 2.2, "size": 2.0, "margin": 1.0, "symbol": "Bunk"}}]}}
        ],
        "BathroomInterior": [
          {"if": "wall_side != ''", "walls": {"sides": ["$wall_side"], "depth": 0.6, "do": [
            {"if": "sx >= 1.4", "place": {"at": ["sx/2 - min(0.6, sx/2 - 0.1)", 0, 0], "size": ["min(1.2, sx - 0.2)", 0.5, 1], "symbol": "Counter"}}]}}
        ],
        "KitchenInterior": [
          {"walls": {"sides": "$wall_sides", "depth": 0.65, "do": [
            {"if": "sx >= 1.6", "place": {"at": [0.7, 0, 0], "size": ["sx - 1.4", 0.6, 1], "symbol": "Counter"}}]}}
        ]
      }
    },
    "facility": {
      "name": "Mixed facility",
      "description": "A corridor spine with rooms of random types (office, storage, security, maintenance, clinic and a server room at the end). The rooms are only shells and doors here: each one is furnished by its room type.",
      "include": "common",
      "start": "Site",
      "size": [36, 16, 3.2],
      "params": {"corridor_width": 2.6, "unit": 6, "door_every": 0, "light_every": 4, "tray": true, "furnish": true},
      "rules": {
        "Site": [{"split": {"axis": "y", "parts": [
          {"size": "~1", "symbol": "UnitRow", "params": {"door_side": "north"}},
          {"size": "corridor_width", "symbol": "Corridor"},
          {"size": "~1", "symbol": "UnitRow", "params": {"door_side": "south"}}
        ]}}],
        "UnitRow": [{"repeat": {"axis": "x", "every": "unit", "symbol": "Unit"}}],
        "Unit": {"variants": [
          {"weight": 3, "do": [{"set": {"kind": "'office'", "label": "'Office'"}}, "TypedRoom"]},
          {"weight": 2, "do": [{"set": {"kind": "'storage'", "label": "'Storage'"}}, "TypedRoom"]},
          {"weight": 1, "do": [{"set": {"kind": "'security'", "label": "'Security'"}}, "TypedRoom"]},
          {"weight": 1, "do": [{"set": {"kind": "'maintenance'", "label": "'Maintenance'"}}, "TypedRoom"]},
          {"weight": 1, "do": [{"set": {"kind": "'clinic'", "label": "'Clinic'"}}, "TypedRoom"]},
          {"weight": 2, "if": "i == n - 1", "do": [{"set": {"kind": "'server_room'", "label": "'Server room'"}}, "TypedRoom"]}
        ]},
        "TypedRoom": [
          {"room": {"type": "$kind", "furnish": "$furnish", "name": "{label}", "wall_thickness": "$wall",
                    "materials": {"walls": "$wall_material", "floor": "$floor_material", "ceiling": "$ceiling_material"}}},
          {"walls": {"sides": ["$door_side"], "depth": 0.5, "do": [{"door": {"width": 1.1, "shift": "-sx/4"}}]}},
          "CeilingLight"
        ]
      }
    },
    "corridor": {
      "name": "Service corridor",
      "description": "Corridor -> walls + door every N m on both sides + ceiling lights + cable tray.",
      "include": "common",
      "start": "Corridor",
      "size": [24, 3.2, 3.2],
      "params": {"door_every": 6, "light_every": 4, "tray": true}
    },
    "industrial": {
      "name": "Industrial block",
      "description": "Service corridor with workshops and storage rooms on both sides; pipes and a cable tray in the corridor.",
      "include": "common",
      "start": "Site",
      "size": [36, 24, 4.5],
      "params": {"unit": 9, "corridor_width": 3, "door_every": 0, "light_every": 4.5, "door_width": 1.6, "door_height": 2.4, "storage_share": 2, "workbench_surface": "industrial_surface", "room_traits": ["industrial"]},
      "rules": {
        "Site": [{"split": {"axis": "y", "parts": [
          {"size": "~1", "symbol": "UnitRow", "params": {"door_side": "north"}},
